{
  "packages": [
    "kind@0.32.0",
    "gh@2.98.0",
    "kubectl@1.36.3",
    "bat@0.26.1",
    "upbound@0.40.3",
    "kubernetes-helm@4.2.4",
    "watchexec@2.5.1",
    "kyverno-chainsaw@0.2.15",
    "just@1.58.0",
    "jq@1.8.2",
    "gum@0.17.0",
    "yq-go@4.53.3",
    "crossplane-cli@2.4.1",
    "viddy@1.3.1",
    "kcl-cli@0.8.9",
    "path:gcloud#google-cloud-sdk",
    "vals@0.46.0",
    "azure-cli@2.89.1",
    "awscli2@2.35.11",
    "nushell@0.115.1",
    "git@2.55.0"
  ],
  "shell": {
    "init_hook": [
      "export PATH=\"$HOME/.local/bin:$PATH\"",
      "[ -n \"$USE_VALS\" ] && eval \"$(vals env -export -f .env.vals.yaml)\" || true",
      "[ -f .env ] && source .env || true"
    ],
    "scripts": {
      "cluster-create":  ["just cluster-create"],
      "cluster-destroy": ["just cluster-destroy"],
      "package-publish": ["just package-publish"],
      "test":            ["just test"],
      "test-watch":      ["just test-watch"]
    }
  }
}
